# Discord Bot Configuration
DISCORDJS_BOT_TOKEN=           # Bot token from https://discord.com/developers/applications
CLIENT_ID=                     # Application/Client ID (same page as bot token)
GUILD_ID=                      # Bootstrap fallback only — set in /admin/settings ("Zugang") instead,
                                # which is used for the admin-role check, preselects the server in the
                                # admin menu, and takes effect without a restart. Empty here means the
                                # bootstrap guild from src/config/defaults.js is used, so a
                                # dev/test instance should point this at its own server.

# Runtime
NODE_ENV=production            # Set to "production" to enable SSL cert verification
LOG_LEVEL=info                 # src/logger.js verbosity: debug/info/warn/error (default: info)

# Raidhelper API (raid-helper.xyz)
RAIDHELPER_API_KEY=            # API key from raid-helper.xyz (real secret, stays here)
RAIDHELPER_SERVER_ID=          # Bootstrap fallback only — set in /admin/settings ("Zugang") instead,
                                # which takes effect without a restart.

# Bot Admin
ADMIN_USER_ID=                 # Discord user ID that has bot admin access

# Application System
APPLICATION_CHANNEL_ID=        # Channel where application threads are created
OFFICER_ROLE_ID=               # Role to ping when a new application arrives
APPLY_ARMORY_URL=              # Armory URL template, {char} = character name (default: Thunderstrike EU)
APPLY_WCL_URL=                 # Warcraft Logs URL template, {char} = character name (default: Thunderstrike fresh EU)
APPLY_WCL_REALM=               # Realm slug the applicant log check looks characters up on (default: thunderstrike)
APPLY_WCL_REGION=              # Region of that realm (default: eu)

# Battle.net API (optional live gear on the character pages). Bootstrap only —
# the admin menu (/admin/settings) can override all of them.
BLIZZARD_CLIENT_ID=            # Battle.net API client id (empty = char pages only link to classic-armory.org)
BLIZZARD_CLIENT_SECRET=        # Battle.net API client secret
BLIZZARD_REGION=               # API region (default: eu)
BLIZZARD_REALM=                # Realm slug (default: thunderstrike)
BLIZZARD_NAMESPACE=            # Profile namespace override (default: auto, profile-classicann-<region>)

# Google Sheets Integration (/fillsetup command)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json  # Path to Google Service Account JSON key
GOOGLE_SPREADSHEET_ID=         # Google Sheets spreadsheet ID (from the sheet URL)
GOOGLE_SHEET_NAME=Setup        # Tab name in the spreadsheet (default: Setup)
GOOGLE_SHEET_GID=              # Sheet id (gid) of that tab (default: 34139428, the Tier 4/5 raidsheet)

# Google OAuth (per-raid sheet COPIES, admin "Raidsheet füllen"). A service
# account can't own Drive files, so copies are created as a real user via OAuth.
# Obtain the refresh token once with: node scripts/get-drive-token.js
GOOGLE_OAUTH_CLIENT_ID=        # OAuth 2.0 client id (Desktop app) from Google Cloud Console
GOOGLE_OAUTH_CLIENT_SECRET=    # OAuth 2.0 client secret
GOOGLE_OAUTH_REFRESH_TOKEN=    # Refresh token from scripts/get-drive-token.js (full Drive access — keep secret)
OAUTH_HELPER_PORT=             # Local port scripts/get-drive-token.js listens on for the OAuth redirect (default: 53682)

# Logcheck (Warcraft Logs gear audit)
WARCRAFTLOGS_API_KEY=          # Warcraft Logs "V1 Client Key" (from classic.warcraftlogs.com/profile)
WEB_PORT=3005                  # Port for the logcheck report web server
PUBLIC_BASE_URL=               # Public base URL for report links, e.g. https://pulse-gdkp.de:3005 (default: http://localhost:WEB_PORT)
DISCORD_CLIENT_SECRET=         # OAuth2 client secret (Discord Dev Portal). Needed for website "Login with Discord".
                               # (CLIENT_SECRET is also accepted.) Also add redirect URI <PUBLIC_BASE_URL>/auth/callback
                               # in the portal (OAuth2 -> Redirects).
# CLIENT_SECRET=               # Older name of DISCORD_CLIENT_SECRET, still read when that one is empty
LOGCHECK_ADMIN_IDS=            # Optional extra Discord user IDs (comma-separated) allowed to delete reports. ADMIN_USER_ID is always admin.
WOWSIMCLI_PATH=                # Optional: path to the wowsimcli binary (node scripts/fetch-wowsimcli.js) for loot-council simulations

# Web Admin Menu (/admin)
# Admin roles and raid defaults are configured IN the admin menu (/admin/settings),
# stored in data/settings/config.json — not here. ADMIN_USER_ID above is the bootstrap
# admin that can always log in to configure the rest.
ADMIN_ROLE_IDS=               # Optional fallback: Discord role IDs (comma-separated) granting admin access.
                              # Normally leave empty and set roles in /admin/settings instead.
DEV_AUTO_LOGIN=               # Set to 1 in .env.dev ONLY: auto-login the local web menu as the first
                              # ADMIN_USER_ID without Discord OAuth, so /admin works on any port with no
                              # callback URL. Ignored when NODE_ENV=production (never bypasses auth live).

# Development and deployment
EVENTHELPER_RH_FIXTURE_CHANNEL= # Dev only: channel the Raid-Helper dev fixture event is shown in (default: channel of the first own event)
GIT_COMMIT=                    # Set by the Docker build (--build-arg GIT_COMMIT=...): the commit the image runs, shown in the admin menu
