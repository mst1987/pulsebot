# Discord Bot Configuration
DISCORDJS_BOT_TOKEN=           # Bot token from https://discord.com/developers/applications
CLIENT_ID=                     # Application/Client ID (same page as bot token)
GUILD_ID=                      # Discord server ID (right-click server -> Copy Server ID)

# Backend API
API_BASE_URL=https://pulse-gdkp.de:3001/api  # Base URL for the GDKP backend

# Runtime
NODE_ENV=production            # Set to "production" to enable SSL cert verification

# Raidhelper API (raid-helper.xyz)
RAIDHELPER_API_KEY=            # API key from raid-helper.xyz
RAIDHELPER_SERVER_ID=          # Your Discord server ID on raid-helper.xyz

# Bot Admin
ADMIN_USER_ID=                 # Discord user ID that has bot admin access (/createauction, etc.)

# Application System
APPLICATION_CHANNEL_ID=        # Channel where application threads are created
OFFICER_ROLE_ID=               # Role to ping when a new application arrives
APPLY_ARMORY_URL=              # Armory URL template, {char} = character name (default: Thunderstrike EU)
APPLY_WCL_URL=                 # Warcraft Logs URL template, {char} = character name (default: Thunderstrike fresh EU)

# Google Sheets Integration (/fillsetup command)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json  # Path to Google Service Account JSON key
GOOGLE_SPREADSHEET_ID=         # Google Sheets spreadsheet ID (from the sheet URL)
GOOGLE_SHEET_NAME=Setup        # Tab name in the spreadsheet (default: Setup)

# Logcheck (Warcraft Logs gear audit)
WARCRAFTLOGS_API_KEY=          # Warcraft Logs "V1 Client Key" (from classic.warcraftlogs.com/profile)
WEB_PORT=3005                  # Port for the logcheck report web server
PUBLIC_BASE_URL=               # Public base URL for report links, e.g. https://pulse-gdkp.de:3005 (default: http://localhost:WEB_PORT)
DISCORD_CLIENT_SECRET=         # OAuth2 client secret (Discord Dev Portal). Needed for website "Login with Discord".
                               # (CLIENT_SECRET is also accepted.) Also add redirect URI <PUBLIC_BASE_URL>/auth/callback
                               # in the portal (OAuth2 -> Redirects).
LOGCHECK_ADMIN_IDS=            # Optional extra Discord user IDs (comma-separated) allowed to delete reports. ADMIN_USER_ID is always admin.

# Web Admin Menu (/admin)
# Admin roles and raid defaults are configured IN the admin menu (/admin/settings),
# stored in data/settings/config.json — not here. ADMIN_USER_ID above is the bootstrap
# admin that can always log in to configure the rest.
ADMIN_ROLE_IDS=               # Optional fallback: Discord role IDs (comma-separated) granting admin access.
                              # Normally leave empty and set roles in /admin/settings instead.
DEV_AUTO_LOGIN=               # Set to 1 in .env.dev ONLY: auto-login the local web menu as the first
                              # ADMIN_USER_ID without Discord OAuth, so /admin works on any port with no
                              # callback URL. Ignored when NODE_ENV=production (never bypasses auth live).
