# Example for /etc/pulsebot/backup.env (#692). Copy it, fill in, then:
#   chmod 600 /etc/pulsebot/backup.env
# Real values never belong into the repository. Setup: docs/backup.md.

# Cloudflare R2 over restic's S3 backend: account id and bucket name
RESTIC_REPOSITORY=s3:https://<account-id>.r2.cloudflarestorage.com/<bucket>

# Preferred: a file with the restic password (mode 600). Keep the same password
# in your password manager - without it the copy cannot be opened.
RESTIC_PASSWORD_FILE=/etc/pulsebot/restic-password
# RESTIC_PASSWORD=...        # alternative to the file, not both

# R2 API token, object read/write for this one bucket only
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Where the snapshot job (#691) writes, and where the bot is checked out (its .env is saved)
BACKUP_DIR=/var/backups/pulsebot
DEPLOY_DIR=/var/www/pulsebot

# Optional, defaults shown
# OFFSITE_KEEP_DAILY=14
# OFFSITE_KEEP_WEEKLY=8
# OFFSITE_KEEP_MONTHLY=12
# OFFSITE_TIMEOUT=2h
# OFFSITE_CHECK_DAY=7        # weekday of restic check (1=Monday, 7=Sunday)
# OFFSITE_CHECK_SUBSET=5%
