{
    "name": "eventhelper",
    "version": "1.0.0",
    "private": true,
    "description": "Discord-Bot und Web-Admin für Raid-Organisation (PulseBot/EventHelper)",
    "main": "src/bot.js",
    "scripts": {
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "start": "node ./src/bot.js",
        "dev": "nodemon ./src/bot.js",
        "lint": "eslint src/ scripts/ .claude/hooks/ test/ jest.config.js",
        "lint:fix": "eslint src/ scripts/ .claude/hooks/ test/ jest.config.js --fix",
        "register": "node scripts/register-commands.js",
        "register:global": "node scripts/register-commands.js --global",
        "register:clear": "node scripts/register-commands.js --clear",
        "register:dev": "node scripts/register-commands.js --dev",
        "agents": "node scripts/agent-overview.js",
        "bis:refresh": "node scripts/fetch-wowhead-bis.js && node scripts/fetch-wowsims-data.js && node scripts/fetch-wowhead-bis.js",
        "emojis:sync": "node scripts/sync-app-emojis.js",
        "emojis:render": "node scripts/render-ui-emojis.js",
        "data:rpb": "node scripts/build-rpb-data.js",
        "data:cla": "node scripts/build-cla-data.js",
        "data:loot": "node scripts/fetch-tbc-loot.js && node scripts/fetch-tbc-loot-names.js",
        "data:icons": "node scripts/fetch-boss-icons.js && node scripts/fetch-mob-icons.js",
        "data:spec-icons": "node scripts/fetch-spec-icons.js",
        "setup:wowsimcli": "node scripts/fetch-wowsimcli.js",
        "dev:seed": "node scripts/seed-test-raid.js",
        "check:main": "node scripts/check-main-clean.js",
        "move": "node scripts/move-files.js",
        "backup:snapshot": "node scripts/backup/snapshot.js",
        "backup:list": "node scripts/backup/list.js",
        "backup:restore": "node scripts/backup/restore.js",
        "backup:restore-test": "node scripts/backup/restore-test.js"
    },
    "nodemonConfig": {
        "ignore": [
            "data/",
            "src/web-client/",
            "test/",
            "coverage/"
        ]
    },
    "keywords": [],
    "author": "",
    "license": "UNLICENSED",
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.133.0",
        "@resvg/resvg-js": "^2.6.2",
        "axios": "^1.21.0",
        "discord.js": "^14.27.0",
        "dotenv": "^18.0.9",
        "googleapis": "^185.0.0",
        "luxon": "^3.7.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.13.0",
        "eslint-plugin-jest": "^29.17.0",
        "globals": "^17.13.0",
        "jest": "^30.5.2",
        "nodemon": "^3.1.14"
    }
}
